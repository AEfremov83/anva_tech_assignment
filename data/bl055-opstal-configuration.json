{
  "allowBack": false,
  "configurationType": "entity",
  "hideInMenu": false,
  "key": "bl055",
  "name": "055 - Opstal",
  "type": "Bl055",
  "schema": {
    "title": "Opstal",
    "type": "object",
    "properties": {
      "id": {
        "format": "uuid",
        "title": "Identificatienummer",
        "type": "string"
      },
      "description": {
        "title": "Omschrijving",
        "type": "string"
      },
      "insuredObject": {
        "title": "Verzekerd object",
